# Alembic 迁移和长期运行 Context API 使用的数据库连接。
ACP_DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/agent_context_platform

# 运行环境标识和日志控制。
ACP_ENV=local
ACP_LOG_LEVEL=INFO
ACP_SQL_ECHO=false

# MCP server wrapper 调用的 Context API 地址。
ACP_CONTEXT_API_BASE_URL=http://127.0.0.1:8000

# MCP server 默认使用 local stdio；remote MCP 仅支持 streamable-http。
# ACP_MCP_TRANSPORT=streamable-http
# ACP_MCP_HOST=127.0.0.1
# ACP_MCP_PORT=8001
# ACP_MCP_PATH=/mcp

# MCP 调试日志默认关闭；只在调试或评测复盘时显式开启。
# ACP_MCP_LOG_FILE=logs/acp-mcp-debug.jsonl
# ACP_MCP_LOG_PAYLOADS=false

# Embedding provider 配置。
# 支持 dashscope、openai、jina；不填时默认 dashscope。
ACP_EMBEDDING_PROVIDER=dashscope
ACP_EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/api/v1
ACP_EMBEDDING_API_KEY=
ACP_EMBEDDING_MODEL=tongyi-embedding-vision-flash-2026-03-06
ACP_EMBEDDING_DIMENSION=768
ACP_EMBEDDING_BATCH_SIZE=10

# Jina / OpenAI-compatible provider 可选 task 配置。
# provider=jina 且不填写时默认 retrieval.passage / retrieval.query。
# ACP_EMBEDDING_DOCUMENT_TASK=retrieval.passage
# ACP_EMBEDDING_QUERY_TASK=retrieval.query
