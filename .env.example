# Alembic 迁移和长期运行 Context API 使用的数据库连接。
ACP_DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/agent_context_platform

# 运行环境标识和日志控制。
ACP_ENV=local
ACP_LOG_LEVEL=INFO
ACP_SQL_ECHO=false

# MCP server wrapper 调用的 Context API 地址。
ACP_CONTEXT_API_BASE_URL=http://127.0.0.1:8000

# embedding provider 配置由运行时加载器校验；任务 12 接入 provider 后会正式使用。
ACP_EMBEDDING_BASE_URL=
ACP_EMBEDDING_API_KEY=
ACP_EMBEDDING_MODEL=
ACP_EMBEDDING_DIMENSION=
ACP_EMBEDDING_BATCH_SIZE=
