# Alembic 迁移和长期运行 Context API 使用的数据库连接。
ACP_DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/agent_context_platform

# 运行环境标识和日志控制。
ACP_ENV=local
ACP_LOG_LEVEL=INFO
ACP_SQL_ECHO=false

# 单 code repo 本地运行时可设置默认 repo；该值必须与 acp-index --repo 一致。
# ACP_DEFAULT_REPO=gitlab.example.com/group/project
# ACP_REQUIRE_REPO_FILTER=false
# ACP_ALIAS_FILE=eval/corpora/smart-campus/aliases.json

# MCP server wrapper 调用的 Context API 地址。
ACP_CONTEXT_API_BASE_URL=http://127.0.0.1:8000

# MCP server 默认使用 local stdio；remote MCP 仅支持 streamable-http。
# ACP_MCP_TRANSPORT=streamable-http
# ACP_MCP_HOST=127.0.0.1
# ACP_MCP_PORT=8001
# ACP_MCP_PATH=/mcp

# MCP 调试日志默认关闭；只在调试或评测复盘时显式开启。
# ACP_MCP_LOG_FILE=logs/acp-mcp-debug.jsonl
# ACP_MCP_LOG_PAYLOADS=false

# Embedding provider 配置。
# openai: OpenAI-compatible /v1/embeddings，base_url 可填 API root 或完整 /embeddings endpoint。
# infer: message-style /infer，base_url 必须填完整 /infer endpoint。
# 默认不启用 embedding。需要写入或查询向量时，取消整组注释并填写真实 key。
# ACP_EMBEDDING_PROVIDER=openai
# ACP_EMBEDDING_BASE_URL=https://embedding-gateway.example.com/v1
# ACP_EMBEDDING_API_KEY=<your-api-key>
# ACP_EMBEDDING_MODEL=Qwen3-Embedding-4B
# ACP_EMBEDDING_DIMENSION=1024
# ACP_EMBEDDING_BATCH_SIZE=10
